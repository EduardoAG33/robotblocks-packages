  "permissions": [],
  "assets": [],
  "metadata": {
    "experimental": true,
    "group": "boards",
    "translations": {
      "en": {
        "Lógica de 3.3 V; NO tolerante a 5 V. LED RGB integrado (LEDR/LEDG/LEDB), activo en bajo. ADC leído a 10 bits y PWM de 8 bits por defecto. Generación C++ experimental; carga pendiente de Fase 8 y validación física.": "3.3 V logic; NOT 5 V tolerant. Built-in active-low RGB LED (LEDR/LEDG/LEDB). ADC read at 10 bits and 8-bit PWM by default. Experimental C++ generation; upload pending Phase 8 and physical validation.",
        "Lógica de 3.3 V; NO tolerante a 5 V. LED RGB integrado (LEDR/LEDG/LEDB), activo en bajo. ADC leído a 10 bits y PWM de 8 bits por defecto.": "3.3 V logic; NOT 5 V tolerant. Built-in active-low RGB LED (LEDR/LEDG/LEDB). ADC read at 10 bits and 8-bit PWM by default.",
        "UART hardware; la serie USB usa un puerto independiente.": "Hardware UART; USB serial uses a separate port.",
        "Conector de cámara; no usar como GPIO mientras se utiliza la cámara.": "Camera connector; do not use as GPIO while the camera is active.",
        "Conector de pantalla/cámara; no usar como GPIO con ese periférico activo.": "Display/camera connector; do not use as GPIO with that peripheral active.",
        "Compartido con entrada de micrófono del jack de audio.": "Shared with the audio jack microphone input.",
        "Solo analógico; sin GPIO digital.": "Analog only; no digital GPIO.",
        "DAC real (no PWM), compartido con el jack de audio. Arduino usa A12.": "True DAC (not PWM), shared with the audio jack. Arduino uses A12.",
        "DAC real (no PWM), compartido con el jack de audio. Arduino usa A13.": "True DAC (not PWM), shared with the audio jack. Arduino uses A13.",
        "Compartido con CAN; requiere transceptor externo.": "Shared with CAN; requires an external transceiver.",
        "I2C Wire1; duplicado en el conector de cámara.": "I2C Wire1; duplicated on the camera connector.",
        "LED RGB integrado de ánodo común: bajo enciende, alto apaga. D86.": "Built-in common-anode RGB LED: low turns it on, high turns it off. D86.",
        "LED RGB integrado de ánodo común: bajo enciende, alto apaga. D87.": "Built-in common-anode RGB LED: low turns it on, high turns it off. D87.",
        "LED RGB integrado de ánodo común: bajo enciende, alto apaga. D88.": "Built-in common-anode RGB LED: low turns it on, high turns it off. D88."
      }
    }
  },
