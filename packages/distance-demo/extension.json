{
  "schemaVersion": 2,
  "id": "org.robotblocks.demo-distance-sensor",
  "name": "Sensor de distancia · demo",
  "version": "1.2.0",
  "author": { "name": "RobotBlocks" },
  "minAppVersion": "0.4.0",
  "description": "Un bloque de lectura para demostrar el registro de extensiones. No contiene un driver ni devuelve telemetría real.",
  "requiredCapabilities": [],
  "supportedBoards": [],
  "dependencies": [],
  "permissions": [],
  "contributes": {
    "categories": [
      { "id": "org.robotblocks.demo-distance-sensor:distance", "name": "Distancia demo", "colour": "#D16FE8" }
    ],
    "blocks": ["blocks/index.json"],
    "devices": [
      {
        "id": "org.robotblocks.demo-distance-sensor:sensor",
        "name": "Sensor de distancia demo",
        "capabilities": ["sensor", "distance"],
        "requiredCapabilities": ["i2c"],
        "pins": [{ "name": "i2c", "label": { "es": "Bus I2C", "en": "I2C bus" }, "capabilities": ["i2c"] }]
      },
      {
        "id": "org.robotblocks.demo-distance-sensor:ultrasonic",
        "name": "Sensor de dos pines · demo",
        "capabilities": ["sensor", "distance"],
        "requiredCapabilities": [],
        "pins": [
          { "name": "trig", "label": { "es": "Trigger", "en": "Trigger" }, "capabilities": ["digitalOutput"] },
          { "name": "echo", "label": { "es": "Echo", "en": "Echo" }, "capabilities": ["digitalInput"] }
        ]
      }
    ],
    "boards": [],
    "generators": [
      {
        "id": "org.robotblocks.demo-distance-sensor:preview",
        "target": "ir-preview",
        "entry": "generator/descriptor.json",
        "irVersion": 2
      }
    ],
    "monitors": [
      {
        "id": "org.robotblocks.demo-distance-sensor:distance-monitor",
        "name": "Distancia",
        "valueType": "number",
        "unit": "cm"
      }
    ]
  },
  "assets": [],
  "metadata": {
    "demo": true,
    "group": "sensors",
    "translations": {
      "en": {
        "Sensor de distancia · demo": "Distance sensor · demo",
        "Un bloque de lectura para demostrar el registro de extensiones. No contiene un driver ni devuelve telemetría real.": "A reading block demonstrating extension registration. Contains no driver and returns no real telemetry.",
        "Distancia demo": "Demo distance",
        "Sensor de distancia demo": "Demo distance sensor",
        "Sensor de dos pines · demo": "Two-pin sensor · demo",
        "Distancia": "Distance",
        "Punto de integración futuro. No genera código ejecutable.": "Future integration point. Does not generate executable code."
      }
    }
  }
}
