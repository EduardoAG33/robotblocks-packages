{
  "titulo": "HuskyLens 2 · todos los bloques",
  "tarjetas": ["arduino-uno", "arduino-uno-r4-minima", "arduino-giga-r1", "teensy-40", "seeed-xiao-esp32s3"],
  "pines": {
    "arduino-uno": {
      "SDA": "a4",
      "SCL": "a5"
    },
    "arduino-uno-r4-minima": {
      "SDA": "a4",
      "SCL": "a5"
    },
    "arduino-giga-r1": {
      "SDA": "d102",
      "SCL": "d101"
    },
    "teensy-40": {
      "SDA": "d18",
      "SCL": "d19"
    },
    "seeed-xiao-esp32s3": {
      "SDA": "d4",
      "SCL": "d5"
    }
  },
  "variables": {
    "n": 0
  },
  "programa": [
    [
      ":configure-i2c",
      {
        "SDA": "$SDA",
        "SCL": "$SCL"
      }
    ],
    [
      ":algorithm",
      {
        "ALGORITHM": "2"
      }
    ],
    [":forget"],
    [":learn"],
    [
      "core:serial-println",
      {},
      {
        "VALUE": [
          "core:join",
          {},
          {
            "LEFT": "aprendido ",
            "RIGHT": [
              "core:to-text",
              {},
              {
                "VALUE": [":last-learned"]
              }
            ]
          }
        ]
      }
    ],
    [
      "core:forever",
      {},
      {
        "BODY": [
          [":update"],
          [
            "core:set",
            {
              "VARIABLE": "n"
            },
            {
              "VALUE": [":count"]
            }
          ],
          [
            "core:if",
            {},
            {
              "CONDITION": [
                ":kind-seen",
                {
                  "KIND": "b"
                }
              ],
              "BODY": [
                [
                  "core:serial-println",
                  {},
                  {
                    "VALUE": [
                      "core:join",
                      {},
                      {
                        "LEFT": "x ",
                        "RIGHT": [
                          "core:to-text",
                          {},
                          {
                            "VALUE": [
                              ":center",
                              {
                                "PROP": "0",
                                "KIND": "b"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ],
                [
                  "core:serial-println",
                  {},
                  {
                    "VALUE": [
                      ":center-text",
                      {
                        "WHAT": "n"
                      }
                    ]
                  }
                ]
              ]
            }
          ],
          [
            "core:if",
            {},
            {
              "CONDITION": [
                ":id-seen",
                {},
                {
                  "ID": 1
                }
              ],
              "BODY": [
                [
                  "core:serial-println",
                  {},
                  {
                    "VALUE": [
                      "core:join",
                      {},
                      {
                        "LEFT": "ancho ",
                        "RIGHT": [
                          "core:to-text",
                          {},
                          {
                            "VALUE": [
                              ":id-prop",
                              {
                                "PROP": "2"
                              },
                              {
                                "ID": 1
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ],
                [
                  "core:serial-println",
                  {},
                  {
                    "VALUE": [
                      ":id-text",
                      {
                        "WHAT": "c"
                      },
                      {
                        "ID": 1
                      }
                    ]
                  }
                ]
              ]
            }
          ],
          [
            "core:serial-println",
            {},
            {
              "VALUE": [
                "core:join",
                {},
                {
                  "LEFT": "aprendidos ",
                  "RIGHT": [
                    "core:to-text",
                    {},
                    {
                      "VALUE": [":learned-count"]
                    }
                  ]
                }
              ]
            }
          ],
          [
            "core:wait-ms",
            {},
            {
              "MS": 100
            }
          ]
        ]
      }
    ]
  ],
  "destinos": ["arduino"]
}
