      {
        "id": "org.robotblocks.lego-ev3-devices:motor-power",
        "category": "org.robotblocks.lego-ev3-devices:motors",
        "label": { "es": "motor %PORT encender a potencia %POWER %", "en": "motor %PORT run at power %POWER %" },
        "kind": "command",
        "fields": [
          {
            "name": "PORT",
            "type": "string",
            "default": "a",
            "reference": { "kind": "resource", "capabilities": ["ev3MotorPort"] }
          }
        ],
        "inputs": [{ "name": "POWER", "type": "number", "default": 50, "slider": { "min": -100, "max": 100 } }],
        "operation": "org.robotblocks.lego-ev3-devices:motor-power",
        "tooltip": { "es": "EV3 Pybricks 2.0 experimental.", "en": "Experimental EV3 Pybricks 2.0." },
        "requiredCapabilities": ["ev3MotorPort"],
        "generators": {
          "pybricks": {
            "globals": [
              "try:\n    import os as ev3_os\nexcept ImportError:\n    import uos as ev3_os\n",
              "_ev3_power_max = {}\n\ndef ev3_power_speed(port, power):\n    # Potencia de EV3-G: al 100 % el grande va a unos 1050 grados/s y el mediano a 1560.\n    # El tipo de motor se lee una sola vez por puerto (leer sysfs en cada vuelta de un PD es lento).\n    if port not in _ev3_power_max:\n        maximum = 1050\n        try:\n            suffix = {Port.A: 'outA', Port.B: 'outB', Port.C: 'outC', Port.D: 'outD'}[port]\n            for entry in ev3_os.listdir('/sys/class/tacho-motor'):\n                path = '/sys/class/tacho-motor/' + entry + '/'\n                with open(path + 'address') as f:\n                    address = f.read().strip()\n                if address.endswith(suffix):\n                    with open(path + 'driver_name') as f:\n                        if f.read().strip() == 'lego-ev3-m-motor':\n                            maximum = 1560\n                    break\n        except (OSError, KeyError):\n            pass\n        _ev3_power_max[port] = maximum\n    return max(-100, min(100, power)) * _ev3_power_max[port] / 100\n"
            ],
            "statement": "rb_motor({PORT}, {BLOCK_ID}).run(ev3_power_speed({PORT}, {POWER}))"
          }
        }
      },
      {
        "id": "org.robotblocks.lego-ev3-devices:motor-angle-power",
        "category": "org.robotblocks.lego-ev3-devices:motors",
        "label": {
          "es": "motor %PORT girar %ANGLE grados a potencia %POWER % y %THEN",
          "en": "motor %PORT run %ANGLE degrees at power %POWER % and %THEN"
        },
        "kind": "command",
        "fields": [
          {
            "name": "PORT",
            "type": "string",
            "default": "a",
            "reference": { "kind": "resource", "capabilities": ["ev3MotorPort"] }
          },
          {
            "name": "THEN",
            "type": "string",
            "default": "brake",
            "options": [
              { "label": { "es": "frenar", "en": "brake" }, "value": "brake" },
              { "label": { "es": "mantener", "en": "hold" }, "value": "hold" },
              { "label": { "es": "soltar", "en": "coast" }, "value": "coast" }
            ]
          }
        ],
        "inputs": [
          { "name": "ANGLE", "type": "number", "default": 90 },
          { "name": "POWER", "type": "number", "default": 50, "slider": { "min": -100, "max": 100 } }
        ],
        "operation": "org.robotblocks.lego-ev3-devices:motor-angle-power",
        "tooltip": { "es": "EV3 Pybricks 2.0 experimental.", "en": "Experimental EV3 Pybricks 2.0." },
        "requiredCapabilities": ["ev3MotorPort"],
        "generators": {
          "pybricks": {
            "cooperative": true,
            "globals": [
              "try:\n    import os as ev3_os\nexcept ImportError:\n    import uos as ev3_os\n",
              "_ev3_power_max = {}\n\ndef ev3_power_speed(port, power):\n    # Potencia de EV3-G: al 100 % el grande va a unos 1050 grados/s y el mediano a 1560.\n    # El tipo de motor se lee una sola vez por puerto (leer sysfs en cada vuelta de un PD es lento).\n    if port not in _ev3_power_max:\n        maximum = 1050\n        try:\n            suffix = {Port.A: 'outA', Port.B: 'outB', Port.C: 'outC', Port.D: 'outD'}[port]\n            for entry in ev3_os.listdir('/sys/class/tacho-motor'):\n                path = '/sys/class/tacho-motor/' + entry + '/'\n                with open(path + 'address') as f:\n                    address = f.read().strip()\n                if address.endswith(suffix):\n                    with open(path + 'driver_name') as f:\n                        if f.read().strip() == 'lego-ev3-m-motor':\n                            maximum = 1560\n                    break\n        except (OSError, KeyError):\n            pass\n        _ev3_power_max[port] = maximum\n    return max(-100, min(100, power)) * _ev3_power_max[port] / 100\n",
              "from pybricks.parameters import Stop",
              "def ev3_stop_mode(mode):\n    return {'brake': Stop.BRAKE, 'hold': Stop.HOLD, 'coast': Stop.COAST}[mode]\n"
            ],
            "statement": "await rb_blocking(({PORT},), {BLOCK_ID}, rb_motor({PORT}, {BLOCK_ID}).run_angle, ev3_power_speed({PORT}, {POWER}), {ANGLE}, ev3_stop_mode({THEN}))"
          }
        }
      },
