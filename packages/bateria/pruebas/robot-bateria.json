{
  "titulo": "Batería · aviso de batería baja",
  "ejemplo": "arduino-giga-r1",
  "tarjetas": [
    "arduino-uno",
    "arduino-uno-r4-minima",
    "arduino-giga-r1",
    "teensy-40",
    "seeed-xiao-esp32s3",
    "dfrobot-firebeetle-esp32"
  ],
  "pines": {
    "arduino-uno": {
      "BAT": "a0",
      "SDA": "a4",
      "SCL": "a5"
    },
    "arduino-uno-r4-minima": {
      "BAT": "a0",
      "SDA": "a4",
      "SCL": "a5"
    },
    "arduino-giga-r1": {
      "BAT": "a0",
      "SDA": "d102",
      "SCL": "d101"
    },
    "teensy-40": {
      "BAT": "d14",
      "SDA": "d18",
      "SCL": "d19"
    },
    "seeed-xiao-esp32s3": {
      "BAT": "d0",
      "SDA": "d4",
      "SCL": "d5"
    },
    "dfrobot-firebeetle-esp32": {
      "BAT": "gpio36",
      "SDA": "gpio21",
      "SCL": "gpio22"
    }
  },
  "variables": {
    "voltaje": 0,
    "porcentaje": 0,
    "corriente": 0
  },
  "programa": [
    [
      ":configure",
      {
        "PIN": "$BAT",
        "R1": 20,
        "R2": 10,
        "VREF": 3.3
      }
    ],
    [
      ":ina-configure",
      {
        "ADDR": "0x40",
        "SDA": "$SDA",
        "SCL": "$SCL"
      }
    ],
    [
      "core:forever",
      {},
      {
        "BODY": [
          [
            "core:set",
            {
              "VARIABLE": "voltaje"
            },
            {
              "VALUE": [":voltage"]
            }
          ],
          [
            "core:set",
            {
              "VARIABLE": "porcentaje"
            },
            {
              "VALUE": [
                ":percent",
                {},
                {
                  "MIN": 6.4,
                  "MAX": 8.4
                }
              ]
            }
          ],
          [
            "core:set",
            {
              "VARIABLE": "corriente"
            },
            {
              "VALUE": [":ina-current"]
            }
          ],
          [
            "core:if",
            {},
            {
              "CONDITION": [
                ":low",
                {},
                {
                  "V": 6.8
                }
              ],
              "BODY": [
                [
                  "core:serial-println",
                  {},
                  {
                    "VALUE": "¡Batería baja! Cárgala."
                  }
                ]
              ]
            }
          ],
          [
            "core:serial-println",
            {},
            {
              "VALUE": [
                "core:join",
                {},
                {
                  "LEFT": "mA: ",
                  "RIGHT": [
                    "core:to-text",
                    {},
                    {
                      "VALUE": {
                        "var": "corriente"
                      }
                    }
                  ]
                }
              ]
            }
          ],
          [
            "core:wait-ms",
            {},
            {
              "MS": 1000
            }
          ]
        ]
      }
    ]
  ]
}
