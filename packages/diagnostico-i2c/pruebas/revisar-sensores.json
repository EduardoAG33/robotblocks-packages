{
  "titulo": "Diagnóstico I2C · revisar sensores al arrancar",
  "ejemplo": "arduino-giga-r1",
  "tarjetas": [
    "arduino-giga-r1",
    "arduino-uno",
    "arduino-uno-r4-minima",
    "teensy-40",
    "seeed-xiao-esp32s3",
    "dfrobot-firebeetle-esp32"
  ],
  "pines": {
    "arduino-giga-r1": { "SDA": "d102", "SCL": "d101" },
    "arduino-uno": { "SDA": "a4", "SCL": "a5" },
    "arduino-uno-r4-minima": { "SDA": "a4", "SCL": "a5" },
    "teensy-40": { "SDA": "d18", "SCL": "d19" },
    "seeed-xiao-esp32s3": { "SDA": "d4", "SCL": "d5" },
    "dfrobot-firebeetle-esp32": { "SDA": "gpio21", "SCL": "gpio22" }
  },
  "variables": { "dispositivos": 0 },
  "programa": [
    [":scan", { "SDA": "$SDA", "SCL": "$SCL" }],
    ["core:set", { "VARIABLE": "dispositivos" }, { "VALUE": [":count", { "SDA": "$SDA", "SCL": "$SCL" }] }],
    [
      "core:if",
      {},
      {
        "CONDITION": ["core:not", {}, { "VALUE": [":present", { "ADDR": "0x28", "SDA": "$SDA", "SCL": "$SCL" }] }],
        "BODY": [
          [
            "core:serial-println",
            {},
            { "VALUE": "¡Falta la IMU BNO055 (0x28)! Revisa cables y el interruptor de la batería." }
          ]
        ]
      }
    ],
    [
      "core:if",
      {},
      {
        "CONDITION": ["core:less", {}, { "LEFT": { "var": "dispositivos" }, "RIGHT": 3 }],
        "BODY": [
          [
            "core:serial-println",
            {},
            {
              "VALUE": [
                "core:join",
                {},
                { "LEFT": "Solo responden ", "RIGHT": ["core:to-text", {}, { "VALUE": { "var": "dispositivos" } }] }
              ]
            }
          ]
        ]
      }
    ]
  ]
}
