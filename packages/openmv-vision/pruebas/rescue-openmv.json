{
  "titulo": "Visión OpenMV · Rescue Line: verde y plateado al GIGA",
  "ejemplo": "openmv-cam-h7",
  "tarjetas": ["openmv-cam-h7"],
  "programa": [
    [
      ":start",
      {
        "MODE": "color",
        "SIZE": "qqvga",
        "LIGHT": "fijo"
      }
    ],
    [
      ":uart-configure",
      {},
      {
        "BAUD": 19200
      }
    ],
    [
      "core:forever",
      {},
      {
        "BODY": [
          [":snapshot"],
          [
            ":find-color",
            {
              "COLOR": "verde"
            },
            {
              "MIN": 150
            }
          ],
          [
            "core:if-else",
            {},
            {
              "CONDITION": [":found"],
              "THEN": [
                [
                  ":send",
                  {},
                  {
                    "TYPE": 1,
                    "DATA1": [
                      ":blob",
                      {
                        "PROP": "dx"
                      }
                    ],
                    "DATA2": [
                      ":blob",
                      {
                        "PROP": "area"
                      }
                    ]
                  }
                ],
                [
                  ":led",
                  {
                    "COLOR": "verde"
                  }
                ]
              ],
              "ELSE": [
                [
                  ":find-color",
                  {
                    "COLOR": "blanco"
                  },
                  {
                    "MIN": 300
                  }
                ],
                [
                  "core:if-else",
                  {},
                  {
                    "CONDITION": [":found"],
                    "THEN": [
                      [
                        ":send",
                        {},
                        {
                          "TYPE": 2,
                          "DATA1": [
                            ":blob",
                            {
                              "PROP": "dx"
                            }
                          ],
                          "DATA2": [
                            ":blob",
                            {
                              "PROP": "area"
                            }
                          ]
                        }
                      ],
                      [
                        ":led",
                        {
                          "COLOR": "blanco"
                        }
                      ]
                    ],
                    "ELSE": [
                      [
                        ":send",
                        {},
                        {
                          "TYPE": 0,
                          "DATA1": 0
                        }
                      ],
                      [
                        ":led",
                        {
                          "COLOR": "apagado"
                        }
                      ]
                    ]
                  }
                ]
              ]
            }
          ]
        ]
      }
    ]
  ],
  "simulados": "simulados",
  "tiempo": 0.3,
  "evaluar": [
    ["vis_uart.sent[0]", "1:20,500*10\n"],
    ["[__import__(\"pyb\").leds[n] for n in (1, 2, 3)]", [false, true, false]]
  ]
}
