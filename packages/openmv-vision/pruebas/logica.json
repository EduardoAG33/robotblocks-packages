{
  "titulo": "Visión OpenMV · prueba con cámara simulada",
  "tarjetas": ["openmv-cam-h7"],
  "simulados": "simulados",
  "variables": {
    "dx": 0,
    "area": 0,
    "manchas": 0,
    "angulo": 0,
    "desplazamiento": 0,
    "calidad": 0,
    "tag": 0,
    "giro": 0,
    "qr": ""
  },
  "programa": [
    [
      ":start",
      {
        "MODE": "color",
        "SIZE": "qvga",
        "LIGHT": "fijo"
      }
    ],
    [
      ":uart-configure",
      {},
      {
        "BAUD": 19200
      }
    ],
    [":snapshot"],
    [
      ":find-color",
      {
        "COLOR": "verde"
      },
      {
        "MIN": 50
      }
    ],
    [
      "core:set",
      {
        "VARIABLE": "dx"
      },
      {
        "VALUE": [
          ":blob",
          {
            "PROP": "dx"
          }
        ]
      }
    ],
    [
      "core:set",
      {
        "VARIABLE": "area"
      },
      {
        "VALUE": [
          ":blob",
          {
            "PROP": "area"
          }
        ]
      }
    ],
    [
      "core:set",
      {
        "VARIABLE": "manchas"
      },
      {
        "VALUE": [":blob-count"]
      }
    ],
    [
      ":find-line",
      {
        "COLOR": "negro"
      }
    ],
    [
      "core:set",
      {
        "VARIABLE": "angulo"
      },
      {
        "VALUE": [
          ":line",
          {
            "PROP": "angulo"
          }
        ]
      }
    ],
    [
      "core:set",
      {
        "VARIABLE": "desplazamiento"
      },
      {
        "VALUE": [
          ":line",
          {
            "PROP": "desplazamiento"
          }
        ]
      }
    ],
    [
      "core:set",
      {
        "VARIABLE": "calidad"
      },
      {
        "VALUE": [
          ":line",
          {
            "PROP": "calidad"
          }
        ]
      }
    ],
    [":find-tags"],
    [
      "core:set",
      {
        "VARIABLE": "tag"
      },
      {
        "VALUE": [
          ":tag",
          {
            "PROP": "id"
          }
        ]
      }
    ],
    [
      "core:set",
      {
        "VARIABLE": "giro"
      },
      {
        "VALUE": [
          ":tag",
          {
            "PROP": "giro"
          }
        ]
      }
    ],
    [":find-qr"],
    [
      "core:set",
      {
        "VARIABLE": "qr"
      },
      {
        "VALUE": [":qr"]
      }
    ],
    [
      ":led",
      {
        "COLOR": "verde"
      }
    ],
    [
      ":send",
      {},
      {
        "TYPE": 2,
        "DATA1": {
          "var": "dx"
        },
        "DATA2": {
          "var": "area"
        },
        "DATA3": {
          "var": "angulo"
        },
        "DATA4": {
          "var": "desplazamiento"
        },
        "DATA5": {
          "var": "tag"
        }
      }
    ]
  ],
  "esperado": {
    "dx": -60,
    "area": 500,
    "manchas": 2,
    "angulo": -5,
    "desplazamiento": 0,
    "calidad": 42,
    "tag": 7,
    "giro": 90,
    "qr": "SALIDA"
  },
  "evaluar": [
    ["vis_uart.sent[-1]", "2:-60,500,-5,0,7*09\n"],
    ["[__import__(\"pyb\").leds[n] for n in (1, 2, 3)]", [false, true, false]],
    ["__import__(\"sensor\").state[\"gain\"]", false]
  ]
}
