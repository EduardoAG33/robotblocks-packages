    "label": "PWM %PIN a %VALUE %",
    "kind": "command",
    "fields": [
      {
        "name": "PIN",
        "type": "string",
        "default": "",
        "reference": {
          "kind": "resource",
          "capabilities": [
            "pwm"
          ]
        }
      }
    ],
    "inputs": [
      {
        "name": "VALUE",
        "type": "number",
        "default": 50,
        "min": 0,
        "max": 100,
        "integer": true
      }
    ],
    "tooltip": "MicroPython ESP32 experimental. Revisa las capacidades y las notas del pin antes de cargar. Arduino experimental: API del core, sin librerías externas.",
    "requiredCapabilities": [
      "pwm"
    ],
    "generators": {
      "micropython": {
        "imports": [
          "from machine import Pin, PWM"
        ],
        "setup": [
          "pwm_{PIN} = PWM(Pin({PIN}), freq=5000)"
        ],
        "statement": "pwm_{PIN}.duty(int({VALUE} * 1023 / 100))",
        "canFail": false
      },
      "arduino": {
        "setup": [
          "pinMode({PIN}, OUTPUT);"
        ],
        "statement": "analogWrite({PIN}, int({VALUE} * 255 / 100));",
        "canFail": false
      }
    }
  },
