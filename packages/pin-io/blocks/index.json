  {
    "id": "org.robotblocks.demo-board-io:digital-write",
    "operation": "org.robotblocks.demo-board-io:digital-write",
    "category": "org.robotblocks.demo-board-io:pins",
    "label": { "es": "poner %PIN en %STATE", "en": "set %PIN to %STATE" },
    "kind": "command",
    "fields": [
      {
        "name": "PIN",
        "type": "string",
        "default": "",
        "reference": { "kind": "resource", "capabilities": ["digitalOutput"] }
      },
      {
        "name": "STATE",
        "type": "string",
        "default": "high",
        "options": [
          { "label": { "es": "alto", "en": "high" }, "value": "high" },
          { "label": { "es": "bajo", "en": "low" }, "value": "low" }
        ]
      }
    ],
    "inputs": [],
    "tooltip": {
      "es": "MicroPython ESP32 experimental. Revisa las capacidades y las notas del pin antes de cargar. Arduino experimental: API del core, sin librerías externas.",
      "en": "Experimental ESP32 MicroPython. Check pin capabilities and notes before uploading. Experimental Arduino: core API, no external libraries."
    },
    "requiredCapabilities": ["digitalOutput"],
    "generators": {
      "micropython": {
        "imports": ["from machine import Pin, PWM"],
        "setup": ["pin_{PIN} = Pin({PIN}, Pin.OUT)"],
        "statement": "pin_{PIN}.value({STATE} == \"high\")",
        "canFail": false
      },
      "arduino": {
        "setup": ["pinMode({PIN}, OUTPUT);"],
        "statement": "digitalWrite({PIN}, String({STATE}) == String(\"high\") ? 1 : 0);",
        "canFail": false
      }
    }
  },
