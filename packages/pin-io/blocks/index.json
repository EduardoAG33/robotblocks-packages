[
  {
    "id": "org.robotblocks.demo-board-io:digital-read",
    "operation": "org.robotblocks.demo-board-io:digital-read",
    "category": "org.robotblocks.demo-board-io:pins",
    "label": "pin digital %PIN está alto",
    "kind": "boolean",
    "output": "boolean",
    "fields": [
      {
        "name": "PIN",
        "type": "string",
        "default": "",
        "reference": {
          "kind": "resource",
          "capabilities": [
            "digitalInput"
          ]
        }
      }
    ],
    "inputs": [],
    "tooltip": "MicroPython ESP32 experimental. Revisa las capacidades y las notas del pin antes de cargar. Arduino experimental: API del core, sin librerías externas.",
    "requiredCapabilities": [
      "digitalInput"
    ],
    "generators": {
      "micropython": {
        "imports": [
          "from machine import Pin, PWM"
        ],
        "setup": [
          "input_pin_{PIN} = Pin({PIN}, Pin.IN)"
        ],
        "expression": "input_pin_{PIN}.value() != 0",
        "canFail": false
      },
      "arduino": {
        "setup": [
          "pinMode({PIN}, INPUT);"
        ],
        "expression": "digitalRead({PIN}) != 0",
        "canFail": false
      }
    }
  },
  {
    "id": "org.robotblocks.demo-board-io:digital-write",
    "operation": "org.robotblocks.demo-board-io:digital-write",
    "category": "org.robotblocks.demo-board-io:pins",
    "label": "poner %PIN en %STATE",
    "kind": "command",
    "fields": [
      {
        "name": "PIN",
        "type": "string",
        "default": "",
        "reference": {
          "kind": "resource",
          "capabilities": [
            "digitalOutput"
          ]
        }
      },
      {
        "name": "STATE",
        "type": "string",
        "default": "high",
        "options": [
          {
            "label": "alto",
            "value": "high"
          },
          {
            "label": "bajo",
            "value": "low"
          }
        ]
      }
    ],
    "inputs": [],
    "tooltip": "MicroPython ESP32 experimental. Revisa las capacidades y las notas del pin antes de cargar. Arduino experimental: API del core, sin librerías externas.",
    "requiredCapabilities": [
      "digitalOutput"
    ],
    "generators": {
      "micropython": {
        "imports": [
          "from machine import Pin, PWM"
        ],
        "setup": [
          "pin_{PIN} = Pin({PIN}, Pin.OUT)"
        ],
        "statement": "pin_{PIN}.value({STATE} == \"high\")",
        "canFail": false
      },
      "arduino": {
        "setup": [
          "pinMode({PIN}, OUTPUT);"
        ],
        "statement": "digitalWrite({PIN}, String({STATE}) == String(\"high\") ? 1 : 0);",
        "canFail": false
      }
    }
  },
  {
    "id": "org.robotblocks.demo-board-io:analog-read",
    "operation": "org.robotblocks.demo-board-io:analog-read",
    "category": "org.robotblocks.demo-board-io:pins",
    "label": "leer pin analógico %PIN",
    "kind": "reporter",
    "output": "number",
    "fields": [
      {
        "name": "PIN",
        "type": "string",
        "default": "",
        "reference": {
          "kind": "resource",
          "capabilities": [
            "analogInput"
          ]
        }
      }
    ],
    "inputs": [],
    "tooltip": "ESP32: ADC de 12 bits (0–4095), atenuación 11 dB. ADC2 no disponible con WiFi activo. Arduino experimental: API del core, sin librerías externas.",
    "requiredCapabilities": [
      "analogInput"
    ],
    "generators": {
      "micropython": {
        "imports": [
          "from machine import Pin, PWM"
        ],
        "setup": [
          "adc_{PIN} = rb_adc({PIN}, {BLOCK_ID})"
        ],
        "expression": "rb_adc_read(adc_{PIN}, {BLOCK_ID})"
      },
      "arduino": {
        "expression": "analogRead({PIN})",
        "canFail": false
      }
    }
  },
  {
