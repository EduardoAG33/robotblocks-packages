          ]
        }
      }
    ],
    "inputs": [],
    "tooltip": "Deja de enviar pulsos: el servo ya no mantiene su posición. Servo de 50 Hz (SG90, MG90S, MG996R). Aliméntalo con 5 V externos y une las tierras. MicroPython experimental.",
    "generators": {
      "micropython": {
        "imports": [
          "from machine import Pin, PWM"
        ],
        "setup": [
          "servo_{PIN} = PWM(Pin({PIN}), freq=50, duty_u16=0)"
        ],
